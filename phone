#!/usr/bin/env bb
;; Host-side reconciler for the fleet's Android phones. The phone is a target,
;; not a runtime: steps run from a workstation over ssh (Termux) and adb
;; (Android), check state before mutating, and re-running is always safe. The
;; only things living on-device are the pushed payload files — notably the
;; Termux:Boot hooks, which must work at boot with no host around.
;;
;;   phone apply  [device]   converge (default: pixel8)
;;   phone verify [device]   check only, exit non-zero on drift
;;   phone adopt  [device]   fold the device's manual pkg installs into packages.txt
;;   phone onboard <serial>  first contact over USB adb, then: phone apply
(require '[engine] '[transport] '[nixos-config] '[onboard])

;; the Termux uid is the only per-device datum; everything else derives from
;; the name (which must match the machine's entry in nixos-config's
;; flake/machines.nix, androidDevice = true)
(def devices {"pixel8" "u0_a366", "nothing1" "u0_a779"})

;; policy files; registration order is execution order
(require '[android16-exec] '[always-on-vpn] '[airplane-radios] '[fast-animations] '[wifi-scan-throttle] '[wireless-adb] '[termux-boot] '[sshd] '[userland])

(defn- with-device [name f]
  (let [name (or name "pixel8")
        uid (or (devices name) (do (println "unknown device:" name) (System/exit 1)))
        dev {:ssh (str uid "@" name ".tail.avolt.net")
             :adb (str name ".tail.avolt.net:5555")}]
    (binding [transport/*dev* dev]
      (when-not (transport/ssh-ok? "true")
        (println "unreachable over ssh:" (:ssh dev)) (System/exit 1))
      (f name dev))))

(let [[cmd arg] *command-line-args*]
  (case cmd
    "onboard"
    (onboard/run (or arg (do (println "usage: phone onboard <adb-serial>") (System/exit 1))))

    "adopt"
    (with-device arg (fn [_ _] (userland/adopt)))

    ("apply" "verify")
    (with-device arg
      (fn [name dev]
        (println (format "== %s %s (%s)" cmd name (:ssh dev)))
        ;; renders take seconds of nix; overlap them with the early steps
        (future (try @nixos-config/authorized-keys-file @nixos-config/ssh-config-file
                     (catch Exception _)))
        (let [fails (engine/converge {:check-only (= cmd "verify")
                                      :probes {:adb transport/adb-plane-up?}})]
          (when (pos? fails)
            (println fails "step(s) failed/drifted") (System/exit 1))
          (println "converged"))))

    (do (println "usage: phone {apply|verify|adopt} [device] | phone onboard <serial>")
        (System/exit 1))))
