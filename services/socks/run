#!/data/data/com.termux/files/usr/bin/sh
# Bind the tailnet address, not 0.0.0.0: the proxy authenticates nobody, Termux cannot firewall, and the phone roams onto untrusted wifi — a wildcard bind is an open relay for whoever else is on that network. ifconfig, not ip — the Termux uid may not open netlink sockets on some ROMs, while ifconfig's ioctls work everywhere. No tailnet yet (VPN still coming up, or the address moved and the old bind died) → pace the retry and let runit call again.
IP=$(ifconfig 2>/dev/null | sed -n 's/.*inet \(100\.64\.[0-9.]*\) .*/\1/p' | head -n1)
if [ -z "$IP" ]; then sleep 10; exit 1; fi
# -q because a proxy logs a line per connection, and runit would spool every one of them to disk on a phone.
exec microsocks -i "$IP" -p 1080 -q 2>&1
