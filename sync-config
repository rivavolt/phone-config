#!/usr/bin/env bash
# Regenerate ssh_config from nixos-config's phone-ssh-config generator, whose
# single source of truth is modules/shared/ssh-keys.nix.
# Run this on a dev machine (riva/watts/mac) whenever you add a host in
# ssh-keys.nix (or change the generator's extras), then commit + push.
#
# Unlike sync-keys, this shells out to nix: the config layout (keepalive
# preamble, per-host blocks, the surface override, the tailnet catch-all) lives
# in the generator, so vendoring its rendered output keeps everything in lockstep
# instead of re-deriving the format here.

set -euo pipefail

NIXOS_CONFIG="${NIXOS_CONFIG:-$HOME/dev/nixos-config}"
DST="$(dirname "$0")/ssh_config"

[ -d "$NIXOS_CONFIG" ] || { echo "nixos-config not found: $NIXOS_CONFIG" >&2; exit 1; }

# Build the rendered config file (phone-ssh-config's passthru.config) via the
# pkgs overlay and copy it in. Uses --impure so it works against the working
# tree without committing, and without the flake needing a `packages` output.
out=$(nix build --no-link --print-out-paths --impure --expr "
  (import <nixpkgs> { overlays = [ (import $NIXOS_CONFIG/pkgs) ]; })
    .andrei.phone-ssh-config.config
")

install -m 644 "$out" "$DST"

echo "wrote $DST ($(grep -c '^Host ' "$DST") Host blocks)"
