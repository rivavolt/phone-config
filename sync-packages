#!/usr/bin/env -S uv run --script --quiet
# /// script
# dependencies = [
#   "sh",
# ]
# ///

import pickle, os
from pathlib import Path
import sh

def load_cache(f): 
    try: return pickle.loads(f.read_bytes())
    except: return set()

def save_cache(f, data):
    f.parent.mkdir(exist_ok=True)
    f.write_bytes(pickle.dumps(data))

def load_packages(f):
    return set(f.read_text().strip().split()) if f.exists() else set()

host = os.environ['TERMUX_HOST']
cache_file = Path.home() / '.cache/termux-packages.pkl'
packages_file = Path('packages.txt')

current = set(sh.ssh(host, 'pkg list-installed | grep -v automatic | cut -d/ -f1').split())
previous = load_cache(cache_file)
local = load_packages(packages_file)

new, removed = current - previous, previous - current

if new | removed:
    packages_file.write_text('\n'.join(sorted((local | new) - removed)))
    print(f"±{len(new)}/{len(removed)}")

save_cache(cache_file, current)
