#!/usr/bin/env bash
# Regenerate authorized_keys from nixos-config's userKeys.
# Run this on a dev machine (riva/watts/mac) whenever you add a device key in
# ~/dev/nixos-config/modules/shared/ssh-keys.nix, then commit + push.
#
# Pure bash/grep — no nix evaluator required, so it works anywhere this repo
# is checked out next to nixos-config.

set -euo pipefail

SRC="${NIXOS_CONFIG:-$HOME/dev/nixos-config}/modules/shared/ssh-keys.nix"
DST="$(dirname "$0")/authorized_keys"

[ -f "$SRC" ] || { echo "source not found: $SRC" >&2; exit 1; }

# Extract the userKeys = { ... }; block, then pull each `<name> = "<key>";` line.
# Phone is omitted on purpose: a phone shouldn't list its own key.
awk '
  /userKeys[[:space:]]*=[[:space:]]*\{/ { in_block = 1; next }
  in_block && /^[[:space:]]*\}[[:space:]]*;/ { in_block = 0 }
  in_block {
    if (match($0, /([a-zA-Z0-9_-]+)[[:space:]]*=[[:space:]]*"([^"]+)"/, m)) {
      print m[1], m[2]
    }
  }
' "$SRC" | {
  {
    echo "# Generated by ./sync-keys from nixos-config/modules/shared/ssh-keys.nix."
    echo "# Do not edit by hand. To add a device, add it there and re-run sync-keys."
    while read -r name key; do
      [ "$name" = "phone" ] && continue
      printf '%s\n' "$key"
    done
  } > "$DST.tmp"
  mv "$DST.tmp" "$DST"
}

echo "wrote $DST ($(grep -c '^ssh-' "$DST") keys)"
